---
export const prerender = true;

import type { CollectionEntry } from "astro:content";
import { render } from "astro:content";
import CodeCopy from "@/components/CodeCopy.astro";
import TagLink from "@/components/primitives/TagLink.astro";
import Layout from "@/layouts/Layout.astro";
import Newsletter from "@/components/Newsletter.astro";
import PostAuthor from "@/components/posts/PostAuthor.astro";
import { postBreadcrumbs } from "@/lib/breadcrumbs";
import { formatPostDate, getPublishedPosts } from "@/lib/posts";
import { blogPostingSchema } from "@/lib/seo";
import { personProfiles, siteName } from "@/lib/site";

export async function getStaticPaths() {
  const posts = await getPublishedPosts();
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

type Props = { post: CollectionEntry<"posts"> };
const { post } = Astro.props as Props;
const { Content } = await render(post);
const path = `/post/${post.id}`;
const pageTitle = post.data.seoTitle ?? post.data.title;
const displayDate = post.data.updatedDate ?? post.data.pubDate;

const structuredData = blogPostingSchema({
  title: post.data.title,
  description: post.data.description,
  datePublished: post.data.pubDate.toISOString(),
  dateModified: (post.data.updatedDate ?? post.data.pubDate).toISOString(),
  path,
});
---

<Layout
  title={pageTitle}
  description={post.data.description}
  ogTitle={post.data.ogTitle}
  ogDescription={post.data.ogDescription}
  canonicalPath={path}
  ogType="article"
  breadcrumbs={postBreadcrumbs(post)}
  structuredData={structuredData}
>
  <Fragment slot="head">
    <meta name="author" content={siteName} />
    <link rel="author" href={personProfiles.x} />
    <meta property="article:author" content={personProfiles.x} />
    <meta property="article:published_time" content={post.data.pubDate.toISOString()} />
    <meta property="article:modified_time" content={displayDate.toISOString()} />
    {post.data.tags.map((tag: string) => <meta property="article:tag" content={tag} />)}
  </Fragment>
  <article class="site-frame py-12 sm:py-16">
    <div class="flex flex-col gap-3">
      <h1 class="text-pretty text-2xl font-medium text-foreground">
        {post.data.title}
      </h1>
      <PostAuthor date={displayDate} dateLabel={formatPostDate(displayDate)} />
      {post.data.tags.length > 0 ? (
        <div class="flex flex-wrap items-center gap-x-3 gap-y-1 text-sm text-foreground-soft">
          {post.data.tags.map((tag: string) => (
            <TagLink tag={tag} />
          ))}
        </div>
      ) : null}
    </div>

    <div class="content-prose mt-10">
      <Content />
    </div>
    <CodeCopy />

    <div class="mt-16">
      <Newsletter
        heading="Get the next one"
        description="Subscribe and I'll email you when I publish something new."
        source={`ian.is/post/${post.id}`}
      />
    </div>
  </article>
</Layout>
