---
export const prerender = true;

import Layout from "@/layouts/Layout.astro";
import Newsletter from "@/components/Newsletter.astro";
import PageHeader from "@/components/page/PageHeader.astro";
import LinkList from "@/components/page/LinkList.astro";
import LinkItem from "@/components/page/LinkItem.astro";
import { tools } from "@/lib/tools";
import { pageBreadcrumbs } from "@/lib/breadcrumbs";
import { webPageSchema } from "@/lib/seo";

const structuredData = webPageSchema({
  title: "Tools",
  description: "Free tools for SEO and AI.",
  path: "/tools",
  type: "CollectionPage",
});
---

<Layout
  title="Tools"
  description="Free tools for SEO and AI."
  canonicalPath="/tools"
  breadcrumbs={pageBreadcrumbs("Tools", "/tools")}
  structuredData={structuredData}
>
  <div class="site-frame py-12 sm:py-16">
    <PageHeader title="Tools" subtitle="Free tools for SEO and AI.">
      {tools.length === 0 ? (
        <p class="text-foreground-muted">
          Nothing here yet, but the first ones are on the way.
        </p>
      ) : null}
    </PageHeader>

    {tools.length > 0 ? (
      <div class="mt-12">
        <LinkList>
          {tools.map((tool) => (
            <LinkItem title={tool.title} href={tool.href} headingLevel="h3">
              {tool.description}
            </LinkItem>
          ))}
        </LinkList>
      </div>
    ) : null}

    <div class="mt-12">
      <Newsletter
        heading="Be first to try them"
        description="Subscribe and I'll email you when new tools go live."
      />
    </div>
  </div>
</Layout>
