---
export const prerender = true;

import Layout from "@/layouts/Layout.astro";
import { siteName } from "@/lib/site";
---

<Layout
  title="Page not found"
  description={`The page you were looking for does not exist on ${siteName}.`}
  canonicalPath="/404"
  noIndex
>
  <section class="site-frame grid min-h-[60svh] content-center gap-4 py-16">
    <p class="text-sm text-foreground-soft">404</p>
    <h1 class="text-xl font-medium text-foreground">
      Page not found
    </h1>
    <p class="max-w-lg text-foreground-muted">
      This page does not exist, or the URL has changed.
    </p>
    <a
      href="/"
      class="mt-2 inline-flex h-10 w-fit items-center justify-center rounded-md bg-foreground px-5 text-sm font-medium text-background transition-opacity hover:opacity-85"
    >
      Go home
    </a>
  </section>
</Layout>
