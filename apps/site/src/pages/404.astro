---
export const prerender = true;

import Layout from "@/layouts/Layout.astro";
import { siteName } from "@/lib/site";
---

<Layout
  title="Page not found"
  description={`The page you were looking for does not exist on ${siteName}.`}
  canonicalPath="/404"
  noIndex
>
  <section class="site-frame grid min-h-[60svh] content-center gap-4 py-16">
    <p class="text-sm font-medium text-primary">404</p>
    <h1 class="text-4xl/tight font-semibold text-foreground sm:text-5xl/tight">
      Page not found
    </h1>
    <p class="max-w-lg text-foreground-muted">
      This page does not exist, or the URL has changed. These links can help
      you find the right page.
    </p>
    <ul class="mt-2 flex flex-wrap gap-x-5 gap-y-3 text-sm font-medium">
      <li><a class="text-primary underline underline-offset-2 hover:decoration-dotted" href="/">Homepage</a></li>
      <li><a class="text-primary underline underline-offset-2 hover:decoration-dotted" href="/sitemap.xml">Site map</a></li>
      <li><a class="text-primary underline underline-offset-2 hover:decoration-dotted" href="/llms.txt">Agent index</a></li>
      <li><a class="text-primary underline underline-offset-2 hover:decoration-dotted" href="/developers">Developer resources</a></li>
    </ul>
  </section>
</Layout>
