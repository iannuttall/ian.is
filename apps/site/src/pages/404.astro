---
export const prerender = true;

import Layout from "@/layouts/Layout.astro";
import { siteName } from "@/lib/site";
---

<Layout
  title="Page not found"
  description={`The page you were looking for does not exist on ${siteName}.`}
  canonicalPath="/404"
  noIndex
>
  <section class="site-frame grid min-h-[60svh] content-center gap-4 py-16">
    <p class="text-sm text-foreground-soft">404</p>
    <h1 class="text-xl font-medium text-foreground">
      Page not found
    </h1>
    <p class="max-w-lg text-foreground-muted">
      This page does not exist, or the URL has changed. These links can help
      you find the right page.
    </p>
    <ul class="mt-2 flex flex-wrap gap-x-5 gap-y-3 text-sm">
      <li><a class="font-medium text-foreground no-underline transition-colors hover:text-foreground-soft" href="/">Homepage</a></li>
      <li><a class="font-medium text-foreground no-underline transition-colors hover:text-foreground-soft" href="/sitemap.xml">Site map</a></li>
      <li><a class="font-medium text-foreground no-underline transition-colors hover:text-foreground-soft" href="/llms.txt">Agent index</a></li>
      <li><a class="font-medium text-foreground no-underline transition-colors hover:text-foreground-soft" href="/developers">Developer resources</a></li>
    </ul>
  </section>
</Layout>
