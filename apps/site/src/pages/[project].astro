---
export const prerender = true;

import Layout from "@/layouts/Layout.astro";
import IloMark from "@/components/icons/IloMark.astro";
import KeepMark from "@/components/icons/KeepMark.astro";
import MailroomMark from "@/components/icons/MailroomMark.astro";
import SeoSkillMark from "@/components/icons/SeoSkillMark.astro";
import SwipeMark from "@/components/icons/SwipeMark.astro";
import UnclaimedMark from "@/components/icons/UnclaimedMark.astro";
import FaqSection from "@/components/page/FaqSection.astro";
import ProjectActions from "@/components/projects/ProjectActions.astro";
import ProjectDemo from "@/components/projects/ProjectDemo.astro";
import ProjectDetails from "@/components/projects/ProjectDetails.astro";
import ProjectFeatures from "@/components/projects/ProjectFeatures.astro";
import { pageBreadcrumbs } from "@/lib/breadcrumbs";
import { fetchLatestRelease, fetchStars } from "@/lib/github-release";
import { projectFaqs, projectPages } from "@/lib/projects";

export function getStaticPaths() {
  return projectPages.map((project) => ({ params: { project: project.slug }, props: { project } }));
}

const { project } = Astro.props;
const canonicalPath = `/${project.slug}`;
const marks = {
  "seo-skill": SeoSkillMark,
  swipe: SwipeMark,
  ilo: IloMark,
  keep: KeepMark,
  unclaimed: UnclaimedMark,
  mailroom: MailroomMark,
} as const;
const Mark = marks[project.slug as keyof typeof marks];

const isDownload = project.primaryAction.kind === "download";
const [stars, release] = await Promise.all([
  project.repo ? fetchStars(project.repo) : Promise.resolve(null),
  isDownload && project.repo ? fetchLatestRelease(project.repo) : Promise.resolve(null),
]);

// Downloads mirror Portman's hover detail (version · size · platform); the
// license already shows under the GitHub button. Without a published release
// we fall back to the static platform · license line.
const primaryDetail = release
  ? [release.version, release.sizeLabel, project.platform].filter(Boolean).join(" · ")
  : project.primaryDetail ?? `${project.platform} · ${project.license}`;

const actionProps = {
  repo: project.repo,
  stars,
  primaryLabel: project.primaryAction.label,
  primaryHref: project.primaryAction.href,
  primaryKind: project.primaryAction.kind,
  primaryDetail,
  verifyHref: isDownload && release && project.repo ? `https://github.com/${project.repo}#verify-a-downloaded-build` : undefined,
};
const structuredData = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  name: project.name,
  applicationCategory: "DeveloperApplication",
  operatingSystem: project.platform,
  url: `https://ian.is${canonicalPath}`,
  sameAs: [project.websiteUrl, project.repo ? `https://github.com/${project.repo}` : undefined].filter(Boolean),
  ...(release ? { softwareVersion: release.version.replace(/^v/, "") } : {}),
  author: { "@type": "Person", name: "Ian Nuttall", url: "https://ian.is" },
};
---

<Layout
  title={project.metaTitle}
  description={project.metaDescription}
  ogTitle={project.name}
  canonicalPath={canonicalPath}
  breadcrumbs={pageBreadcrumbs(project.name, canonicalPath)}
  structuredData={structuredData}
>
  <section class="flex flex-col border-b border-border bg-background pt-4 text-foreground">
    <div class="site-frame">
      <div class="flex flex-col gap-8 pt-12 sm:pt-16">
        <div class="flex max-w-2xl flex-col gap-4">
          <h1 class="text-pretty text-xl font-medium">
            {project.title}
          </h1>
          <p class="text-pretty text-base text-foreground-muted">
            {project.description}
          </p>
        </div>

        <ProjectActions {...actionProps}>
          {Mark ? <Mark slot="icon" class="size-4" /> : null}
        </ProjectActions>
        <ProjectDemo project={project} />
      </div>
    </div>
  </section>

  <ProjectFeatures project={project} />
  <ProjectDetails project={project} />
  <FaqSection heading={`Common questions about ${project.name}`} items={projectFaqs(project)} idPrefix={`${project.slug}-faq`} />

  <section class="site-frame py-12 sm:py-16">
    <div class="flex flex-col items-start gap-6">
      <h2 class="max-w-2xl text-pretty text-lg font-medium">
        {project.closing}
      </h2>
      <div class="contents" data-agent-markdown="exclude">
        <ProjectActions {...actionProps}>
          {Mark ? <Mark slot="icon" class="size-4" /> : null}
        </ProjectActions>
      </div>
    </div>
  </section>
</Layout>
