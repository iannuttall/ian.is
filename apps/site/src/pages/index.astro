---
export const prerender = true;

import Layout from "@/layouts/Layout.astro";
import Newsletter from "@/components/Newsletter.astro";
import ContributionsSection from "@/components/page/ContributionsSection.astro";
import ProjectsSection from "@/components/page/ProjectsSection.astro";
import PostListSection from "@/components/posts/PostListSection.astro";
import { getPublishedPosts } from "@/lib/posts";
import { webSiteSchema } from "@/lib/seo";

const posts = (await getPublishedPosts()).slice(0, 5);
---

<Layout
  title="Ian Nuttall - Marketer, AI Software Engineer and Entrepreneur"
  titleTemplate={false}
  description="Part entrepreneur, part marketer, part software engineer using AI to build stuff on the internet."
  ogTitle="Ian Nuttall"
  canonicalPath="/"
  structuredData={webSiteSchema()}
>
  <section class="site-frame flex flex-col gap-12 pt-12 sm:pt-16">
    <div class="flex flex-col gap-3">
      <h1 class="text-pretty text-xl font-medium text-foreground">
        Ian Nuttall
      </h1>
      <p class="text-pretty text-base text-foreground-muted">
        Part entrepreneur, part marketer, part software engineer using AI to build stuff on the internet.
      </p>
    </div>
    <Newsletter />
  </section>

  <div class="space-y-16 py-16">
    <section class="site-frame">
      <ProjectsSection />
    </section>

    <section class="site-frame" data-agent-markdown="exclude">
      <ContributionsSection />
    </section>

    {posts.length > 0 ? (
      <section class="site-frame">
        <PostListSection posts={posts} href="/posts" postHeadingLevel="h3" />
      </section>
    ) : null}
  </div>
</Layout>
