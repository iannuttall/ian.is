---
export const prerender = true;

import BotDomainTable, { type BotDomain } from "@/components/BotDomainTable.astro";
import Newsletter from "@/components/Newsletter.astro";
import PageHeader from "@/components/page/PageHeader.astro";
import { botDomainIdeas } from "@/data/bot-domain-ideas";
import botDomains from "@/data/bot-domains.json";
import Layout from "@/layouts/Layout.astro";
import { pageBreadcrumbs } from "@/lib/breadcrumbs";
import { webPageSchema } from "@/lib/seo";

const path = "/bot-domains";
const title = "Available .bot domains";
const ogDescription = "I checked 5,932 short words and found 308 names you can still register.";
const description =
  "A reviewed list of 308 short .bot domains that were available to register on 20 August 2026, with standard and premium prices.";
const domains = (botDomains as BotDomain[]).map((domain) => ({
  ...domain,
  idea: domain.idea ?? botDomainIdeas[domain.domain.replace(".bot", "") as keyof typeof botDomainIdeas],
}));

const structuredData = webPageSchema({
  title,
  description,
  path,
  type: "CollectionPage",
});
---

<Layout
  title="Available .bot Domains: 308 Reviewed Names"
  description={description}
  ogTitle={title}
  ogDescription={ogDescription}
  ogImageVersion="bot-domains-v2"
  canonicalPath={path}
  breadcrumbs={pageBreadcrumbs(title, path)}
  structuredData={structuredData}
>
  <div class="site-frame py-8 sm:py-16">
    <PageHeader
      title={title}
      subtitle={ogDescription}
    >
      <p class="hidden max-w-xl text-base leading-relaxed text-foreground-muted sm:block">
        I reviewed each name for clarity, brand quality, and a plausible bot
        use. Checked on 20 August 2026. The list will get less accurate as
        people register names.
      </p>
      <p class="text-sm leading-relaxed text-foreground-muted sm:hidden">
        Checked 20 August 2026. Availability and prices can change.
      </p>
    </PageHeader>

    <div class="mt-6 sm:mt-10">
      <Newsletter
        compact
        source="ian.is/bot-domains"
      />
    </div>

    <BotDomainTable domains={domains} />
  </div>
</Layout>
