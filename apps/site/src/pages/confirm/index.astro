---
import Layout from "@/layouts/Layout.astro";
import { getButtonClasses } from "@/components/ui/button";

export const prerender = true;
---

<Layout
  title="Confirm your Ian's List subscription"
  description="Confirm that you want to receive Ian's List."
  canonicalPath="/confirm"
  noIndex
>
  <meta slot="head" name="referrer" content="no-referrer" />
  <script
    slot="head"
    is:inline
    src="https://challenges.cloudflare.com/turnstile/v0/api.js?render=explicit"
    async
    defer
  ></script>

  <section class="mx-auto max-w-xl py-16 text-center">
    <h1 class="text-4xl font-medium tracking-tight">Confirm your subscription</h1>
    <div class="mt-6" x-data="subscriptionConfirmation">
      <p x-text="message">Checking this confirmation link...</p>
      <div x-ref="turnstile" class="mt-6 flex justify-center"></div>
      <div x-cloak x-show="status === 'success'" class="mt-8">
        <a href="/" class:list={[getButtonClasses("default", "lg"), "no-underline"]}>Go home</a>
      </div>
    </div>
  </section>
</Layout>
