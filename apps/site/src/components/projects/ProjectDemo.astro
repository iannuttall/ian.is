---
import type { ProjectPage } from "@/lib/projects";
import BarkeepDemo from "./demos/BarkeepDemo.astro";
import CaffeineDemo from "./demos/CaffeineDemo.astro";
import ClockworkDemo from "./demos/ClockworkDemo.astro";
import IloDemo from "./demos/IloDemo.astro";
import KeepDemo from "./demos/KeepDemo.astro";
import MailroomDemo from "./demos/MailroomDemo.astro";
import NatterDemo from "./demos/NatterDemo.astro";
import SeoSkillDemo from "./demos/SeoSkillDemo.astro";
import SwipeDemo from "./demos/SwipeDemo.astro";
import UnclaimedDemo from "./demos/UnclaimedDemo.astro";

type Props = { project: ProjectPage };
const { project } = Astro.props;

const demos = {
  "seo-skill": SeoSkillDemo,
  swipe: SwipeDemo,
  ilo: IloDemo,
  keep: KeepDemo,
  barkeep: BarkeepDemo,
  caffeine: CaffeineDemo,
  natter: NatterDemo,
  clockwork: ClockworkDemo,
  unclaimed: UnclaimedDemo,
  mailroom: MailroomDemo,
} as const;

const Demo = demos[project.slug as keyof typeof demos];
---

<div
  class="relative w-full select-none"
  style={`--project-accent:${project.accent}`}
  data-agent-markdown="exclude"
>
  {Demo ? <Demo /> : null}
</div>

<style is:global>
  [x-cloak] {
    display: none !important;
  }
</style>
