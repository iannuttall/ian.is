---
import type { ProjectPage } from "@/lib/projects";

type Props = { project: ProjectPage };

const { project } = Astro.props;
---

<section class="site-frame py-12 sm:py-16">
  <div class="flex max-w-2xl flex-col gap-3">
    <h2 class="text-pretty text-lg font-medium">
      {project.detailHeading}
    </h2>
  </div>

  <dl class="mt-10 grid gap-x-12 gap-y-8 sm:mt-12 sm:grid-cols-2">
    {
      project.details.map((detail) => (
        <div class="flex flex-col gap-1">
          <dt class="font-medium text-foreground">{detail.title}</dt>
          <dd class="text-pretty text-foreground-muted">{detail.description}</dd>
        </div>
      ))
    }
  </dl>
</section>
