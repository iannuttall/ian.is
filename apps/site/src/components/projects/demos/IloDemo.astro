---
/**
 * ilo demo: post patterns on the left, the brief an agent gets on the right.
 * Selecting a pattern swaps the brief so the report feels connected.
 */
---

<div
  class="overflow-hidden rounded-t-2xl border-x border-t border-black/[0.06] bg-background-raised shadow-xs dark:border-white/10"
  x-data="iloDemo"
>
  <div class="flex items-center gap-1.5 border-b border-border-subtle px-4 py-3" aria-hidden="true">
    <span class="size-2 rounded-full bg-foreground/15"></span>
    <span class="size-2 rounded-full bg-foreground/15"></span>
    <span class="size-2 rounded-full bg-foreground/15"></span>
    <span class="ml-2 font-mono text-[10px] text-foreground-soft">ilo · @iannuttall</span>
  </div>

  <div class="grid gap-5 p-5 sm:p-8 md:grid-cols-[1fr_0.9fr]">
    <div class="rounded-xl border border-border bg-background p-5">
      <div class="flex items-center justify-between">
        <span class="text-sm font-medium">Posts by relative reach</span>
        <span class="text-xs text-foreground-soft">Last 90 days</span>
      </div>
      <div class="mt-6 space-y-2">
        <template x-for="pattern in patterns" :key="pattern.name">
          <button
            type="button"
            @click="selected = pattern.name"
            class="block w-full rounded-lg p-2 text-left transition-colors"
            :class="selected === pattern.name ? 'bg-foreground/[0.045]' : 'hover:bg-foreground/[0.03]'"
          >
            <span class="mb-1.5 flex justify-between text-xs">
              <span x-text="pattern.name"></span>
              <span class="text-foreground-soft" x-text="pattern.reach + '%'"></span>
            </span>
            <span class="block h-2 rounded-full bg-foreground/[0.07]">
              <span
                class="block h-full rounded-full bg-[var(--project-accent)] transition-all duration-500"
                :style="`width:${pattern.reach}%`"
              ></span>
            </span>
          </button>
        </template>
      </div>
    </div>

    <div class="flex flex-col rounded-xl bg-[#131418] p-5 text-zinc-200 ring-1 ring-white/10">
      <div class="text-xs font-medium opacity-55">Brief from <span x-text="selected"></span></div>
      <div class="mt-5 text-lg font-medium" x-text="brief().headline"></div>
      <ul class="mt-5 space-y-3 text-xs/5 opacity-75">
        <template x-for="step in brief().steps" :key="step">
          <li class="flex gap-2"><span aria-hidden="true">→</span><span x-text="step"></span></li>
        </template>
      </ul>
      <div class="mt-auto pt-5 font-mono text-[10px] opacity-45" x-text="brief().evidence"></div>
    </div>
  </div>
</div>

<script>
  document.addEventListener("alpine:init", () => {
    const alpine = (window as unknown as { Alpine: import("alpinejs").Alpine }).Alpine;

    const briefs: Record<string, { headline: string; steps: string[]; evidence: string }> = {
      "Build notes": {
        headline: "Show the work behind one small tool.",
        steps: ["Use a concrete opening", "Include one real screenshot", "Keep the first post self-contained"],
        evidence: "evidence: 7 of 9 build-note posts beat typical reach",
      },
      "Practical examples": {
        headline: "Turn one workflow into a walkthrough.",
        steps: ["Start from the finished result", "Show the exact commands", "End with when not to use it"],
        evidence: "evidence: examples with commands earn 2.1x replies",
      },
      "Product links": {
        headline: "Pair every link with a lesson.",
        steps: ["Lead with what you learned", "Put the link after the point", "One link per post"],
        evidence: "evidence: bare links reach 0.4x the account median",
      },
      "General advice": {
        headline: "Retire the generic advice format.",
        steps: ["Swap claims for observations", "Anchor to a real project", "Cut posts with no example"],
        evidence: "evidence: advice posts without examples underperform 3:1",
      },
    };

    alpine.data("iloDemo", () => ({
      selected: "Build notes",
      patterns: [
        { name: "Build notes", reach: 92 },
        { name: "Practical examples", reach: 74 },
        { name: "Product links", reach: 41 },
        { name: "General advice", reach: 26 },
      ],
      brief() {
        return briefs[this.selected] ?? briefs["Build notes"];
      },
    }));
  });
</script>
