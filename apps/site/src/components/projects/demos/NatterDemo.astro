---
/**
 * Natter demo: a Claude Code session where every user turn is dictated. The
 * compact overlay pops out while speech comes in (live waveform, raw
 * mistakes and all), then the cleaned text lands at the prompt and the
 * conversation moves on. Modelled on the real Natter HUD.
 */
---

<div
  class="overflow-hidden rounded-t-2xl border-x border-t border-black/[0.06] bg-background-raised shadow-xs dark:border-white/10"
  x-data="natterDemo"
  x-init="init()"
>
  <div class="flex items-center gap-1.5 border-b border-border-subtle px-4 py-3" aria-hidden="true">
    <span class="size-2 rounded-full bg-foreground/15"></span>
    <span class="size-2 rounded-full bg-foreground/15"></span>
    <span class="size-2 rounded-full bg-foreground/15"></span>
    <span class="ml-2 font-mono text-[10px] text-foreground-soft">natter</span>
  </div>

  <div class="p-5 sm:p-8">
    <div class="relative mx-auto w-full max-w-xl">
    <!-- Claude Code terminal -->
    <div class="flex min-h-[24rem] flex-col overflow-hidden rounded-xl border border-border bg-background">
      <div class="flex items-center justify-between border-b border-border-subtle px-3.5 py-2">
        <span class="text-[11px] text-foreground-soft">Claude Code</span>
        <span class="font-mono text-[10px] text-foreground-soft">~/dev/sites/ian.is</span>
      </div>

      <div class="flex-1 space-y-3 px-3.5 py-3.5 font-mono text-[12.5px]/6">
        <template x-for="entry in history" :key="entry.id">
          <div>
            <span
              :class="entry.role === 'user' ? 'text-foreground-soft' : 'text-[var(--project-accent)]'"
              x-text="entry.role === 'user' ? '>' : '⏺'"
            ></span>
            <span
              class="ml-1.5"
              :class="entry.role === 'user' ? 'text-foreground' : 'text-foreground-muted'"
              x-text="entry.text"
            ></span>
          </div>
        </template>
      </div>

      <div class="border-t border-border-subtle px-3.5 py-3 font-mono text-[12.5px]/6">
        <span class="text-foreground-soft">&gt; </span><span class="text-foreground" x-text="fieldText"></span><span class="natter-caret text-foreground">▍</span>
      </div>
    </div>

    <!-- Natter overlay, popped out over the terminal's corner -->
    <div
      class="absolute -bottom-2 -right-2 w-[21rem] max-w-[calc(100%+0.5rem)] rounded-2xl border border-border bg-background-raised/95 p-3.5 shadow-xl backdrop-blur transition-all duration-300 sm:-right-5"
      :class="live ? 'translate-y-0 scale-100 opacity-100' : 'pointer-events-none translate-y-2 scale-[0.97] opacity-0'"
      @click="skip()"
    >
      <div class="flex items-center gap-3 whitespace-nowrap">
        <span class="shrink-0 text-[12px] font-semibold text-foreground">Agent <span class="font-normal text-foreground-soft" aria-hidden="true">›</span></span>

        <span class="flex h-4 flex-1 items-center justify-center gap-[2px]" :class="live ? 'natter-wave-live' : 'natter-wave-idle'" aria-hidden="true">
          <template x-for="(bar, index) in miniBars" :key="index">
            <span
              class="natter-bar shrink-0 rounded-full bg-cyan-500"
              :style="`height:${bar.height}px; animation-duration:${bar.duration}s; animation-delay:${bar.delay}s`"
            ></span>
          </template>
        </span>
        <span class="shrink-0 text-[11px] font-medium text-cyan-600 dark:text-cyan-400" x-text="phase === 'fixing' ? 'Finishing' : 'Listening'">Listening</span>
      </div>

      <div class="mt-3 min-h-[3rem] border-t border-border-subtle pt-3">
        <p class="font-mono text-[12.5px]/6 text-foreground" x-html="transcriptHtml"></p>
        <p
          class="mt-1 text-[10.5px] text-cyan-600 transition-opacity duration-300 dark:text-cyan-400"
          :class="phase === 'fixing' && note ? 'opacity-100' : 'opacity-0'"
          x-text="note || ' '"
        ></p>
      </div>

      <div class="mt-2 flex items-center justify-between border-t border-border-subtle pt-2.5 text-[10.5px] text-foreground-soft">
        <span>Tab: switch mode · tap <kbd class="rounded border border-border bg-foreground/[0.04] px-1 font-sans">⌥</kbd>: stop</span>
        <span class="rounded-md bg-foreground/[0.06] px-2 py-1 text-foreground-muted">✕ Cancel</span>
      </div>
    </div>

    </div>

    <p class="mt-6 text-center text-[12px] text-foreground-soft">
      Double-tap <kbd class="rounded border border-border bg-foreground/[0.04] px-1 py-px font-sans text-[11px]">⌥</kbd> in any app and just talk. Natter types where your cursor was.
    </p>
  </div>
</div>

<style>
  .natter-caret {
    animation: natter-caret-blink 1.1s steps(2) infinite;
  }
  @keyframes natter-caret-blink {
    50% { opacity: 0; }
  }

  .natter-bar {
    width: 2.5px;
    transform-origin: center;
    animation-name: natter-wave-pulse;
    animation-timing-function: ease-in-out;
    animation-iteration-count: infinite;
  }
  @keyframes natter-wave-pulse {
    0%, 100% { transform: scaleY(0.25); }
    50% { transform: scaleY(1); }
  }
  .natter-wave-live .natter-bar {
    opacity: 0.9;
    animation-play-state: running;
  }
  .natter-wave-idle .natter-bar {
    opacity: 0.3;
    animation-play-state: paused;
  }

  @media (prefers-reduced-motion: reduce) {
    .natter-bar { animation: none; transform: scaleY(0.5); }
    .natter-caret { animation: none; }
  }
</style>

<script>
  document.addEventListener("alpine:init", () => {
    const alpine = (window as unknown as { Alpine: import("alpinejs").Alpine }).Alpine;

    type Utterance = { raw: string; fixed: string; note?: string; reply: string };

    // Short and long, code and prose, so the loop doesn't feel canned.
    const POOL: Utterance[] = [
      {
        raw: "run pnpm ian check site then open the port man release",
        fixed: "Run pnpm ian check site, then open the Portman release.",
        note: "personal rule: port man → Portman",
        reply: "Checks passed, 0 errors. Opening the latest Portman release…",
      },
      { raw: "yes ship it", fixed: "Yes, ship it.", reply: "Pushed to main. Deploy is running." },
      {
        raw: "get hub actions is failing on the deploy step again",
        fixed: "GitHub Actions is failing on the deploy step again.",
        note: "get hub → GitHub",
        reply: "Reading the deploy logs now. Looks like a missing secret.",
      },
      {
        raw: "add a dash dash json flag to the status command",
        fixed: "Add a --json flag to the status command.",
        note: "dash dash json → --json",
        reply: "Added --json to status and updated the help text.",
      },
      {
        raw: "tell claude to refactor the use debounce hook",
        fixed: "Refactor the useDebounce hook.",
        note: "use debounce → useDebounce",
        reply: "Refactored useDebounce. 12 call sites updated, tests green.",
      },
      {
        raw: "cd into tilde slash dev slash sites slash ian dot is",
        fixed: "cd ~/dev/sites/ian.is",
        note: "spoken path → real path",
        reply: "Now in ~/dev/sites/ian.is.",
      },
      {
        raw: "bump astro to seven point one and rerun the checks",
        fixed: "Bump Astro to 7.1 and rerun the checks.",
        note: "seven point one → 7.1",
        reply: "Astro 7.1 installed. astro check is clean.",
      },
      {
        raw: "commit this as fix colon handle empty ports list",
        fixed: "Commit this as “fix: handle empty ports list”.",
        note: "fix colon → fix:",
        reply: "Committed as fix: handle empty ports list.",
      },
      {
        raw: "search the repo for launch d jobs and list the callers",
        fixed: "Search the repo for launchd jobs and list the callers.",
        note: "launch d → launchd",
        reply: "Found 3 launchd registrations. Listing their callers.",
      },
      {
        raw: "ask codex to add tests for the swift p m targets",
        fixed: "Ask Codex to add tests for the SwiftPM targets.",
        note: "swift p m → SwiftPM",
        reply: "Handed off to Codex. Test scaffolds incoming.",
      },
    ];

    const MINI_BARS = 22;
    const FIX_MS = 1400;
    const IDLE_MS = 1900;

    const escapeHtml = (value: string) =>
      value.replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;");

    alpine.data("natterDemo", () => ({
      phase: "idle" as "idle" | "listening" | "fixing",
      index: 0,
      typedCount: 0,
      fieldText: "",
      note: "",
      history: [] as Array<{ id: number; role: "user" | "agent"; text: string }>,
      nextId: 1,
      miniBars: [] as Array<{ height: number; duration: number; delay: number }>,
      timers: [] as number[],

      get live() {
        return this.phase === "listening" || this.phase === "fixing";
      },

      get transcriptHtml() {
        const item = POOL[this.index];
        if (this.phase === "listening") {
          return escapeHtml(item.raw.slice(0, this.typedCount));
        }
        let html = escapeHtml(item.fixed);
        if (item.note) {
          const fixedToken = item.note.split("→").pop()?.trim();
          if (fixedToken) {
            html = html.replace(
              escapeHtml(fixedToken),
              `<mark class="rounded bg-cyan-500/15 px-0.5 text-cyan-700 dark:text-cyan-300">${escapeHtml(fixedToken)}</mark>`,
            );
          }
        }
        return html;
      },

      init() {
        // yap-style bars: random heights, each pulsing on its own duration and
        // negative delay so they never move in unison.
        this.miniBars = Array.from({ length: MINI_BARS }, () => ({
          height: 5 + Math.random() * 11,
          duration: 0.6 + Math.random() * 0.9,
          delay: -Math.random() * 1.6,
        }));

        this.history = [
          { id: this.nextId++, role: "user", text: "What broke the sitemap build?" },
          { id: this.nextId++, role: "agent", text: "A draft post with no slug. Fixed in build-sitemaps.mjs. Want the checks run?" },
        ];

        addEventListener("beforeunload", () => this.timers.forEach(clearTimeout));
        this.later(() => this.speak(0), 1200);
      },

      later(fn: () => void, ms: number) {
        this.timers.push(window.setTimeout(fn, ms));
      },

      clearTimers() {
        this.timers.forEach(clearTimeout);
        this.timers = [];
      },

      push(role: "user" | "agent", text: string) {
        this.history.push({ id: this.nextId++, role, text });
        this.history = this.history.slice(-4);
      },

      speak(index: number) {
        this.clearTimers();
        this.index = index;
        this.typedCount = 0;
        this.note = "";
        this.phase = "listening";

        const item = POOL[index];
        const typeMs = Math.max(34, Math.min(55, Math.round(2400 / item.raw.length)));

        for (let charIndex = 1; charIndex <= item.raw.length; charIndex += 1) {
          this.later(() => (this.typedCount = charIndex), 350 + charIndex * typeMs);
        }

        const doneTyping = 350 + item.raw.length * typeMs;
        this.later(() => {
          this.phase = "fixing";
          this.note = item.note ?? "";
        }, doneTyping + 450);

        const delivered = doneTyping + 450 + FIX_MS;
        this.later(() => {
          this.phase = "idle";
          this.fieldText = item.fixed;
        }, delivered);
        this.later(() => {
          this.fieldText = "";
          this.push("user", item.fixed);
        }, delivered + 1100);
        this.later(() => this.push("agent", item.reply), delivered + 1900);
        this.later(() => this.speak((index + 1) % POOL.length), delivered + 1900 + IDLE_MS);
      },

      skip() {
        this.fieldText = "";
        this.speak((this.index + 1) % POOL.length);
      },
    }));
  });
</script>
