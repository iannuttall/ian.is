---
import FeatureCard from "@/components/page/FeatureCard.astro";
import FeatureGrid from "@/components/page/FeatureGrid.astro";
---

<FeatureGrid heading="What Natter understands that normal Mac dictation misses" columns={2}>
  <FeatureCard
    index={0}
    title="Talk into the current text field"
    description="Double-tap Right Option to start. Natter shows a live transcript, then types the result where your cursor already was."
  >
    <div class="flex w-full max-w-[17rem] flex-col items-center gap-3.5">
      <div class="flex flex-col items-center gap-1.5">
        <kbd class="natter-keycap relative flex h-12 w-14 items-end rounded-lg border border-border bg-background p-1.5 font-sans shadow-sm">
          <span class="absolute right-1.5 top-1 text-[13px] text-foreground">⌥</span>
          <span class="text-[9px] text-foreground-soft">option</span>
        </kbd>
        <span class="text-[11px] text-foreground-soft">double-tap</span>
      </div>
      <div class="flex w-full items-center gap-2 rounded-lg bg-background-raised px-3 py-2.5 shadow-sm ring-1 ring-cyan-500/25">
        <span class="size-1.5 shrink-0 animate-pulse rounded-full bg-cyan-500"></span>
        <span class="font-mono text-[11px] text-foreground-soft">listening · VS Code has focus</span>
      </div>
    </div>
  </FeatureCard>

  <FeatureCard
    index={1}
    title="Keep code and commands intact"
    description="Technical cleanup handles GitHub, SwiftPM, flags, paths, version numbers, commands, and names from your own dictionary."
  >
    <div class="w-full max-w-[17rem] rounded-xl bg-background-raised p-4 shadow-sm ring-1 ring-black/[0.04] dark:ring-white/[0.06]">
      <div class="font-mono text-[12px]">
        <span class="text-foreground-soft line-through">port man</span>
        <span class="mx-2 text-foreground-soft" aria-hidden="true">→</span>
        <span class="rounded bg-cyan-500/12 px-1 py-0.5 font-medium text-cyan-700 dark:text-cyan-300">Portman</span>
      </div>
      <div class="mt-3 space-y-1 font-mono text-[11px] text-foreground-soft">
        <div>get hub <span aria-hidden="true">→</span> GitHub</div>
        <div>dash dash json <span aria-hidden="true">→</span> --json</div>
      </div>
      <div class="mt-3 text-[10px] text-foreground-soft">personal rule applied</div>
    </div>
  </FeatureCard>

  <FeatureCard
    index={2}
    title="Pick the rewrite level"
    description="Raw, Agent, Clean, Email, and Article modes range from direct transcription to local restructuring after you stop."
  >
    <div class="w-full max-w-[17rem]">
      <div class="flex flex-wrap gap-1.5">
        {["Raw", "Agent", "Clean", "Email", "Article"].map((mode) => (
          <span
            class:list={[
              "rounded-full px-2.5 py-1 text-[11px]",
              mode === "Agent"
                ? "bg-cyan-500/12 font-medium text-cyan-700 shadow-sm ring-1 ring-cyan-500/25 dark:text-cyan-300"
                : "bg-background-raised text-foreground-muted shadow-sm ring-1 ring-black/[0.04] dark:ring-white/[0.06]",
            ]}
          >{mode}</span>
        ))}
      </div>
      <p class="mt-3 px-1 text-[11px] text-foreground-soft">Agent: conservative technical cleanup, nothing invented.</p>
    </div>
  </FeatureCard>

  <FeatureCard
    index={3}
    title="Nothing you say gets lost"
    description="If focus moves, keyboard events fail, or a rewrite is rejected, Natter keeps a local recovery record and copies the intended text."
  >
    <div class="flex w-full max-w-[17rem] flex-col gap-2">
      <div class="flex items-center gap-2 rounded-lg bg-background-raised px-3 py-2.5 shadow-sm ring-1 ring-amber-500/20">
        <span class="size-2 shrink-0 rounded-full bg-amber-500"></span>
        <span class="text-[13px] text-foreground">Focus moved mid-sentence</span>
      </div>
      <div class="flex items-center gap-2 rounded-lg bg-background-raised px-3 py-2.5 shadow-sm ring-1 ring-black/[0.04] dark:ring-white/[0.06]">
        <svg class="size-3.5 shrink-0 text-emerald-600 dark:text-emerald-400" viewBox="0 0 16 16" fill="none" aria-hidden="true">
          <path d="M3 8.5l3.5 3.5L13 5" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"></path>
        </svg>
        <span class="text-[13px] text-foreground">Complete transcript copied</span>
        <kbd class="ml-auto rounded border border-border bg-foreground/[0.04] px-1.5 py-0.5 font-sans text-[10px] text-foreground-muted">⌘V</kbd>
      </div>
    </div>
  </FeatureCard>

  <FeatureCard
    index={4}
    title="No cloud transcription"
    description="Audio and transcripts stay on the Mac. There is no account, telemetry, localhost service, or Ollama dependency."
  >
    <div class="w-full max-w-[17rem] overflow-hidden rounded-xl bg-background-raised shadow-sm ring-1 ring-black/[0.04] dark:ring-white/[0.06]">
      <div class="flex items-center gap-2 border-b border-border-subtle px-3 py-2">
        <span class="flex items-center gap-[2px]" aria-hidden="true">
          {[7, 12, 9, 14, 8].map((height) => (
            <span class="block w-[2.5px] rounded-full bg-cyan-500/70" style={`height:${height}px`}></span>
          ))}
        </span>
        <span class="text-[12px] font-medium text-foreground">What leaves the Mac</span>
      </div>
      <div class="flex flex-col gap-1.5 p-3">
        {[
          ["Your audio", "never sent"],
          ["Transcripts", "never sent"],
          ["Rewrites", "run on device"],
          ["Speech model", "downloaded once"],
        ].map(([item, status]) => (
          <div class="flex items-center justify-between text-[12px]">
            <span class="text-foreground">{item}</span>
            <span class="font-mono text-[10px] text-foreground-soft">{status}</span>
          </div>
        ))}
      </div>
    </div>
  </FeatureCard>

  <FeatureCard
    index={5}
    title="Personal rules are plain files"
    description="Preferred spellings and writing rules live as editable Markdown, including corrections you can teach by voice."
  >
    <div class="w-full max-w-[17rem] overflow-hidden rounded-xl bg-background-raised shadow-sm ring-1 ring-black/[0.04] dark:ring-white/[0.06]">
      <div class="border-b border-border-subtle px-3 py-2 font-mono text-[10px] text-foreground-soft">Rules/personal.md</div>
      <div class="space-y-1 p-3.5 font-mono text-[11px]/5 text-foreground-muted">
        <div>- "port man" → "Portman"</div>
        <div>- [Agent] "clawed" → "Claude"</div>
        <div class="text-foreground-soft">- "ian dot is" → "ian.is"</div>
      </div>
    </div>
  </FeatureCard>
</FeatureGrid>

<style>
  /* Two quick presses, then a rest, so it reads as a double-tap without labels. */
  .natter-keycap {
    animation: natter-keycap-tap 2.6s ease-in-out infinite;
    transform-origin: bottom center;
  }
  @keyframes natter-keycap-tap {
    0%, 8%, 16%, 24%, 100% { transform: translateY(0); box-shadow: 0 1px 2px rgb(0 0 0 / 0.08); }
    4%, 20% { transform: translateY(2px); box-shadow: 0 0 0 rgb(0 0 0 / 0.08); }
  }
  @media (prefers-reduced-motion: reduce) {
    .natter-keycap { animation: none; }
  }
</style>
