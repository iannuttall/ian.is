---
import FeatureCard from "@/components/page/FeatureCard.astro";
import FeatureGrid from "@/components/page/FeatureGrid.astro";
---

<FeatureGrid heading="What Unclaimed does before it calls a name free" columns={2}>
  <FeatureCard
    index={0}
    title="Ask the registry twice when it matters"
    description="Unclaimed starts with RDAP, falls back to WHOIS, and confirms an available RDAP response before trusting it."
  >
    <div class="flex w-full max-w-[17rem] flex-col gap-2 text-[12px]">
      <div class="flex items-center rounded-lg bg-background-raised px-3 py-2.5 shadow-sm ring-1 ring-black/[0.04] dark:ring-white/[0.06]">
        <span class="font-mono text-foreground">lumen.tools</span>
        <span class="ml-auto text-foreground-soft">RDAP</span>
      </div>
      <div class="mx-auto h-3 border-l border-dashed border-[var(--project-accent)]/40"></div>
      <div class="flex items-center rounded-lg bg-background-raised px-3 py-2.5 shadow-sm ring-1 ring-[var(--project-accent)]/20">
        <span class="text-foreground">Confirm availability</span>
        <span class="ml-auto font-mono text-[11px] text-[var(--project-accent)]">WHOIS</span>
      </div>
    </div>
  </FeatureCard>

  <FeatureCard
    index={1}
    title="Uncertainty never becomes a bargain"
    description="Timeouts, rate limits, and unfamiliar responses remain unknown instead of appearing in the available list."
  >
    <div class="grid w-full max-w-[17rem] grid-cols-3 gap-2 text-center text-[10px] font-medium">
      <div class="rounded-xl bg-background-raised p-3 shadow-sm ring-1 ring-black/[0.04] dark:ring-white/[0.06]">
        <span class="mx-auto block size-2 rounded-full bg-emerald-500"></span>
        <span class="mt-2 block text-emerald-700 dark:text-emerald-400">available</span>
      </div>
      <div class="rounded-xl bg-background-raised p-3 shadow-sm ring-1 ring-black/[0.04] dark:ring-white/[0.06]">
        <span class="mx-auto block size-2 rounded-full bg-foreground/30"></span>
        <span class="mt-2 block text-foreground-muted">registered</span>
      </div>
      <div class="rounded-xl bg-background-raised p-3 shadow-sm ring-1 ring-amber-500/20">
        <span class="mx-auto block size-2 rounded-full bg-amber-500"></span>
        <span class="mt-2 block text-amber-700 dark:text-amber-400">unknown</span>
      </div>
    </div>
  </FeatureCard>

  <FeatureCard
    index={2}
    title="Stop a sweep and carry on later"
    description="Each answer is committed to local SQLite as it arrives. The next sweep skips confident rows and resumes unresolved work."
  >
    <div class="w-full max-w-[17rem] rounded-xl bg-background-raised p-4 shadow-sm ring-1 ring-black/[0.04] dark:ring-white/[0.06]">
      <div class="flex items-center justify-between text-[11px] text-foreground-soft">
        <span>11,822 words × 3 TLDs</span>
        <span class="font-mono">68%</span>
      </div>
      <div class="mt-3 h-2 overflow-hidden rounded-full bg-foreground/[0.08]">
        <div class="h-full w-[68%] rounded-full bg-[var(--project-accent)]"></div>
      </div>
      <div class="mt-3 grid grid-cols-3 gap-2 text-center text-[10px]">
        <span class="rounded bg-emerald-500/12 px-2 py-1 text-emerald-700 dark:text-emerald-400">saved 24,118</span>
        <span class="rounded bg-foreground/[0.06] px-2 py-1 text-foreground-soft">left 11,348</span>
        <span class="rounded bg-amber-500/12 px-2 py-1 text-amber-700 dark:text-amber-400">retry 91</span>
      </div>
    </div>
  </FeatureCard>

  <FeatureCard
    index={3}
    title="Bring your own words and TLDs"
    description="Load newline or JSON word lists, check any delegated suffix, and save unusual registry routes in one local config file."
  >
    <div class="w-full max-w-[17rem] overflow-hidden rounded-xl bg-[#131418] p-4 font-mono text-[10px]/5 text-zinc-200 shadow-sm ring-1 ring-white/10">
      <div><span class="opacity-45">$</span> unclaimed sweep \\</div>
      <div class="pl-3 opacity-75">--words-file names.txt \\</div>
      <div class="pl-3 opacity-75">--tlds design,tools,co.uk</div>
      <div class="mt-3 text-emerald-300">✓ 3 suffixes · 240 words queued</div>
    </div>
  </FeatureCard>

  <FeatureCard
    index={4}
    title="Browse the useful names, not every row"
    description="Filter by TLD, length, singular form, premium status, price, and corpus, then sort by quality or commercial value."
  >
    <div class="flex w-full max-w-[17rem] flex-col gap-2">
      <div class="flex flex-wrap gap-1.5 text-[10px] text-foreground-muted">
        <span class="rounded-full bg-[var(--project-accent)]/12 px-2 py-1 text-[var(--project-accent)]">.dev</span>
        <span class="rounded-full bg-foreground/[0.06] px-2 py-1">≤ 8 letters</span>
        <span class="rounded-full bg-foreground/[0.06] px-2 py-1">no premium</span>
        <span class="rounded-full bg-foreground/[0.06] px-2 py-1">quality ↓</span>
      </div>
      <div class="flex items-center rounded-lg bg-background-raised px-3 py-2.5 shadow-sm ring-1 ring-black/[0.04] dark:ring-white/[0.06]">
        <span class="font-mono text-[12px] text-foreground">sample.dev</span>
        <span class="ml-auto text-[10px] text-foreground-soft">score 91</span>
      </div>
    </div>
  </FeatureCard>

  <FeatureCard
    index={5}
    title="Install the same guardrails for your agent"
    description="The packaged skill teaches focused commands, resumable scans, and the rule that unknown never means available."
  >
    <div class="w-full max-w-[17rem] overflow-hidden rounded-xl bg-[#131418] p-4 font-mono text-zinc-200 shadow-sm ring-1 ring-white/10">
      <div class="text-[11px]"><span class="opacity-45">$</span> npx skills add iannuttall/unclaimed</div>
      <div class="mt-3 flex items-center gap-2 text-[10px] text-emerald-300">
        <span>✓</span>
        <span>Found 1 skill: unclaimed</span>
      </div>
    </div>
  </FeatureCard>
</FeatureGrid>
