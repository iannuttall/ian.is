---
import FeatureCard from "@/components/page/FeatureCard.astro";
import FeatureGrid from "@/components/page/FeatureGrid.astro";
---

<FeatureGrid heading="What Keep carries from one agent session to the next" columns={2}>
  <FeatureCard
    index={0}
    title="Start with the project notes"
    description="Session hooks show Claude Code, Codex, and Pi the latest notes before work begins. The agent can search the full library when it needs more."
  >
    <div class="w-full max-w-[17rem] overflow-hidden rounded-xl bg-background-raised shadow-sm ring-1 ring-black/[0.04] dark:ring-white/[0.06]">
      <div class="flex items-center justify-between border-b border-border-subtle px-3 py-2">
        <span class="font-mono text-[10px] text-foreground-soft">SessionStart</span>
        <span class="text-[10px] text-emerald-700 dark:text-emerald-400">3 notes loaded</span>
      </div>
      <div class="space-y-2 p-3 text-[11px] text-foreground-muted">
        <div class="rounded-md bg-foreground/[0.055] px-2 py-1.5">Launch decisions</div>
        <div class="rounded-md bg-foreground/[0.055] px-2 py-1.5">Search conventions</div>
        <div class="rounded-md bg-foreground/[0.055] px-2 py-1.5">Open handoff</div>
      </div>
    </div>
  </FeatureCard>

  <FeatureCard
    index={1}
    title="Leave a useful handoff"
    description="The agent records what changed, what remains open, and what the next session needs. Named revisions make every update inspectable."
  >
    <div class="w-full max-w-[17rem] rounded-xl bg-background-raised p-4 shadow-sm ring-1 ring-black/[0.04] dark:ring-white/[0.06]">
      <div class="space-y-2 font-mono text-[11px] text-foreground-muted">
        <div><span class="text-emerald-600 dark:text-emerald-400">[x]</span> Batch feed queries</div>
        <div><span class="text-emerald-600 dark:text-emerald-400">[x]</span> Cache counts at the edge</div>
        <div><span class="text-amber-600 dark:text-amber-400">[/]</span> Fix tag count reads</div>
      </div>
      <div class="mt-4 flex items-center justify-between border-t border-border-subtle pt-3 text-[10px] text-foreground-soft">
        <span>Codex · v13</span>
        <span>+18 −0</span>
      </div>
    </div>
  </FeatureCard>

  <FeatureCard
    index={2}
    title="Search notes and source material together"
    description="A question can pull from project decisions, articles, video transcripts, X threads, feeds, repositories, and uploaded files."
  >
    <div class="w-full max-w-[17rem]">
      <div class="flex items-center gap-2 rounded-lg bg-background-raised px-3 py-2.5 shadow-sm ring-1 ring-black/[0.04] dark:ring-white/[0.06]">
        <svg class="size-3 shrink-0 text-foreground-soft" viewBox="0 0 16 16" fill="none" aria-hidden="true">
          <circle cx="7" cy="7" r="4.5" stroke="currentColor" stroke-width="1.5"></circle>
          <path d="M10.5 10.5L14 14" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"></path>
        </svg>
        <span class="truncate text-[12px] text-foreground">what did we decide about pricing?</span>
      </div>
      <div class="mt-2 flex flex-wrap gap-1.5 px-1 text-[10px] text-foreground-soft">
        <span class="rounded bg-foreground/[0.055] px-1.5 py-0.5">2 notes</span>
        <span class="rounded bg-foreground/[0.055] px-1.5 py-0.5">4 sources</span>
        <span class="rounded bg-foreground/[0.055] px-1.5 py-0.5">project keep</span>
      </div>
    </div>
  </FeatureCard>

  <FeatureCard
    index={3}
    title="Use one library from MCP or the CLI"
    description="Connect a hosted MCP server inside an AI client or install the CLI for terminals and scripts. Both read and write the same context."
  >
    <div class="w-full max-w-[17rem] overflow-hidden rounded-xl bg-[#131418] p-4 font-mono text-zinc-200 shadow-sm ring-1 ring-white/10">
      <div class="text-[10px] opacity-45">keep · zsh</div>
      <div class="mt-3 text-[11px]/5"><span class="opacity-45">$</span> keep search "launch pricing"</div>
      <div class="mt-2 text-[10px] text-emerald-300">2 notes · 4 items · project keep</div>
      <div class="mt-4 flex gap-1.5 text-[10px]">
        <span class="rounded bg-white/10 px-1.5 py-0.5">MCP</span>
        <span class="rounded bg-white/10 px-1.5 py-0.5">CLI</span>
        <span class="rounded bg-white/10 px-1.5 py-0.5">hooks</span>
      </div>
    </div>
  </FeatureCard>

  <FeatureCard
    index={4}
    title="Use the same memory for different work"
    description="Code, writing, research, marketing, personal notes, and planning can share one library while Projects keep each job in scope."
  >
    <div class="flex w-full max-w-[17rem] flex-wrap gap-2">
      {[
        "Code",
        "Write",
        "Research",
        "Marketing",
        "Personal",
        "Planning",
      ].map((label, index) => (
        <span
          class:list={[
            "rounded-lg px-2.5 py-1.5 text-[11px] shadow-sm ring-1",
            index === 0
              ? "bg-[var(--project-accent)]/10 text-[var(--project-accent)] ring-[var(--project-accent)]/20"
              : "bg-background-raised text-foreground-muted ring-black/[0.04] dark:ring-white/[0.06]",
          ]}
        >
          {label}
        </span>
      ))}
    </div>
  </FeatureCard>

  <FeatureCard
    index={5}
    title="Take the whole library with you"
    description="Export every note and saved item as plain markdown files. Your context remains readable without a Keep account or another database."
  >
    <div class="w-full max-w-[17rem] overflow-hidden rounded-xl bg-background-raised shadow-sm ring-1 ring-black/[0.04] dark:ring-white/[0.06]">
      <div class="flex items-center justify-between border-b border-border-subtle px-3 py-2">
        <span class="font-mono text-[10px] text-foreground-soft">keep-export/</span>
        <span class="text-[10px] text-emerald-700 dark:text-emerald-400">complete</span>
      </div>
      <div class="space-y-1.5 p-3 font-mono text-[10px] text-foreground-muted">
        <div>notes/launch-decisions.md</div>
        <div>handoffs/site-redesign.md</div>
        <div>items/agent-memory.md</div>
      </div>
    </div>
  </FeatureCard>
</FeatureGrid>
