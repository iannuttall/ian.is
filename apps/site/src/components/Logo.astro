---
/**
 * The site mark as an inline SVG filled with currentColor, so it takes the
 * text colour of its parent and follows any theme. Sized by height: the
 * default is one em, matching how an icon sits beside text.
 */
type Props = {
  class?: string;
  /** Accessible name. Omit when the parent link already has a label. */
  title?: string;
};

const { class: className, title } = Astro.props;
---

<svg
  viewBox="108 182 400 235"
  fill="currentColor"
  role={title ? "img" : undefined}
  aria-hidden={title ? undefined : "true"}
  class:list={["block h-[1em] w-auto", className]}
>
  {title ? <title>{title}</title> : null}
  <path d="M198.2,213.9l-84.2,198.6h65c8.3,0,17.5-5.5,20.4-12.5l39.9-93.8l0.1-0.9L198.2,213.9z" />
  <path d="M421.1,187.5c-8.3,0-17.4,5.6-20.4,12.5l-35.6,83.9l41.4,90.9l79.5-187.3H421.1z" />
  <path d="M297.9,191.9c-1.7-2.9-5.3-4.5-9.7-4.5h-76.8l25.4,56.7h84.8L297.9,191.9z" />
  <path d="M332.2,267.2h-85.2l63.6,140.8l0.1,0.1c1.6,2.8,5.2,4.4,9.7,4.4h55c5.7,0,12-2.7,16.2-6.7c1.6-1.5,2-3.9,1.1-6L332.2,267.2z" />
</svg>
