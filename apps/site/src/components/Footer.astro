---
/**
 * The footer is one quiet mono line: where the previous visitor came from.
 * It fills in after load from /api/last-visit and stays empty until then,
 * so the layout never shifts.
 */
---

<footer class="site-frame mt-24 pb-10">
  <p
    x-data="lastVisit"
    class="min-h-4 font-mono text-xs text-foreground-soft"
    x-show="label"
    x-cloak
  >
    Last visit from <span x-text="label"></span>
  </p>
</footer>
