---
import HoverHighlight from "@/components/page/HoverHighlight.astro";

type Props = {
  posts: {
    id: string;
    data: {
      title: string;
    };
  }[];
  headingLevel?: "h2" | "h3";
};

const { posts, headingLevel = "h2" } = Astro.props;
const Heading = headingLevel;
const linkClass =
  "flex flex-1 items-center rounded-md px-2 py-1.5 no-underline outline-none focus-visible:bg-foreground/[0.05]";
const titleClass = "text-pretty text-base font-medium text-foreground";
---

<ul class="relative isolate -mx-2 flex flex-col" x-data="hoverGroup">
  <HoverHighlight />
  {
    posts.map((post) => (
      <li class="flex">
        <a href={`/post/${post.id}`} class={linkClass} data-hover-item>
          <Heading class={titleClass}>{post.data.title}</Heading>
        </a>
      </li>
    ))
  }
</ul>
