---
/**
 * Post byline: photo, name, and the date, linking to Ian's X profile with
 * rel="author". The JSON-LD BlogPosting already points its author at the
 * site's Person entity; this is the visible half of that.
 */
import { externalLinkAttrs } from "@/lib/external-links.mjs";
import { personImagePath, personProfiles, siteName } from "@/lib/site";

type Props = {
  date: Date;
  dateLabel: string;
};

const { date, dateLabel } = Astro.props;
---

<p class="flex flex-wrap items-center gap-x-2 gap-y-1 text-sm">
  <a
    {...externalLinkAttrs(personProfiles.x)}
    rel="author noopener"
    class="inline-flex items-center gap-2 font-medium text-foreground no-underline transition-colors hover:text-foreground-soft"
  >
    <img
      src={personImagePath}
      alt=""
      width="24"
      height="24"
      loading="eager"
      decoding="async"
      class="size-6 rounded-full object-cover"
    />
    {siteName}
  </a>
  <span class="text-foreground-soft" aria-hidden="true">·</span>
  <time class="text-foreground-soft" datetime={date.toISOString()}>{dateLabel}</time>
</p>
