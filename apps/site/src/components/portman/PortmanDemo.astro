---
/**
 * An interactive replica of Portman's panel.
 *
 * Not a screenshot: the rows behave the way the real app does. Hovering reveals
 * Kill and Open, killing a row collapses it so the ones below slide up, and it
 * comes back at the bottom of the stack after an unpredictable pause — the way a
 * dev server you restarted rejoins the list.
 */

type Props = {
  /** owner/name — Open sends people here. */
  repo: string;
};

const { repo } = Astro.props;
---

<div
  class="relative w-full select-none"
  x-data={`portmanDemo(${JSON.stringify({ repo })})`}
  x-init="init()"
>
  <!-- Top-rounded with no bottom edge, so the hero section's border-b closes the
       card. Same treatment the newsletter gets on the homepage; a fully rounded
       card floating above the divider is the thing this is deliberately not. -->
  <div
    class="overflow-hidden rounded-t-2xl border-x border-t border-black/[0.06] bg-background-raised shadow-xs dark:border-white/10"
  >
    <!-- Search bar, matching the app's header -->
    <div class="flex items-center gap-2 border-b border-border-subtle px-4 py-3">
      <svg class="size-3.5 shrink-0 text-foreground-soft" viewBox="0 0 16 16" fill="none" aria-hidden="true">
        <circle cx="7" cy="7" r="4.5" stroke="currentColor" stroke-width="1.5"></circle>
        <path d="M10.5 10.5L14 14" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"></path>
      </svg>
      <span class="text-[13px] text-foreground-soft">Search ports, projects, frameworks…</span>
    </div>

    <!-- The list reserves four rows whatever it's currently holding. Killing a
         row collapses it and everything below slides up, so without a floor the
         card would shorten — and the card's bottom edge is the section divider,
         so the whole page below would jump. -->
    <ul
      class="min-h-[var(--demo-list-h)] divide-y divide-border-subtle [--demo-list-h:283px] [--demo-row-h:72px]"
      role="list"
    >
      <template x-for="row in rows" :key="row.id">
        <li
          class="group relative flex items-center gap-3 overflow-hidden px-4 transition-all duration-300 ease-out"
          :class="row.killing ? 'max-h-0 py-0 opacity-0' : 'max-h-[var(--demo-row-h)] py-3 opacity-100'"
          @mouseenter="hovered = row.id"
          @mouseleave="hovered = null"
        >
          <span
            class="size-2 shrink-0 rounded-full transition-colors"
            :class="row.hung ? 'bg-amber-500' : 'bg-emerald-500'"
          ></span>

          <div class="min-w-0 flex-1">
            <div class="flex items-baseline gap-2">
              <span class="truncate text-[15px] font-medium text-foreground" x-text="row.name"></span>
              <span class="font-mono text-[13px] text-emerald-600 dark:text-emerald-400" x-text="':' + row.port"></span>
              <template x-if="row.conflict">
                <span class="rounded bg-amber-500/15 px-1.5 py-px text-[10px] font-medium text-amber-700 dark:text-amber-400">
                  conflict
                </span>
              </template>
            </div>

            <!-- No branch icon: the app's second line is deliberately one piece
                 of text with nothing that can shove anything else sideways as
                 figures refresh, so it doesn't have one either. -->
            <div class="mt-0.5 text-[12px] text-foreground-soft">
              <span class="truncate" x-text="row.meta"></span>
            </div>
          </div>

          <!-- Absolutely positioned: laid out in the flow these would reserve
               width even while hidden, squeezing the meta line into an ellipsis. -->
          <div
            class="absolute right-3 z-10 flex items-center gap-1 rounded-lg bg-background-raised pl-6 transition-opacity duration-150"
            :class="hovered === row.id ? 'opacity-100' : 'pointer-events-none opacity-0'"
          >
            <button
              type="button"
              class="rounded-md bg-red-500/10 px-2.5 py-1 text-[12px] font-medium text-red-600 transition-colors hover:bg-red-500 hover:text-white dark:text-red-400 dark:hover:text-white"
              @click="kill(row)"
            >
              Kill
            </button>
            <button
              type="button"
              class="rounded-md bg-foreground/[0.06] px-2.5 py-1 text-[12px] font-medium text-foreground transition-colors hover:bg-foreground/10"
              @click="open(row)"
            >
              Open
            </button>
          </div>
        </li>
      </template>
    </ul>

    <div class="flex items-center justify-between border-t border-border-subtle px-4 py-2.5">
      <span class="text-[12px] text-foreground-soft">
        <span x-text="rows.filter(r => !r.killing).length"></span> servers listening
      </span>
      <span
        class="text-[12px] text-foreground-soft transition-opacity duration-300"
        :class="note ? 'opacity-100' : 'opacity-0'"
        x-text="note || ' '"
      ></span>
    </div>
  </div>
</div>

<script>
  import type { Alpine } from "alpinejs";

  type DemoRow = {
    id: number;
    name: string;
    port: number;
    meta: string;
    conflict?: boolean;
    hung?: boolean;
    killing: boolean;
  };

  const SEED: Omit<DemoRow, "killing">[] = [
    { id: 1, name: "ian.is", port: 4321, meta: "main · Astro 5.2 · 4h 12m" },
    // Thin space after the dirty marker, matching the app: set solid, the
    // heavier U+2022 collides with the digit.
    { id: 2, name: "seoskill", port: 3000, meta: "feat/reports • 3 · Next.js · 1d 2h" },
    { id: 3, name: "keep", port: 5173, meta: "main · Vite · 22m" },
    { id: 4, name: "ianis/db", port: 5432, meta: "Docker · postgres:16 · 4d 22h" },
  ];

  /** How long a killed server stays down. Varied so repeated kills never feel scripted. */
  const DOWN_MIN_MS = 2000;
  const DOWN_MAX_MS = 7000;

  /** Matches the row's transition duration — remove only once it has collapsed. */
  const COLLAPSE_MS = 300;

  document.addEventListener("alpine:init", () => {
    const alpine = (window as unknown as { Alpine: Alpine }).Alpine;

    alpine.data("portmanDemo", (options: { repo: string }) => ({
      rows: [] as DemoRow[],
      hovered: null as number | null,
      note: "",
      timers: [] as number[],

      init() {
        this.rows = SEED.map((row) => ({ ...row, killing: false }));
        // Anything scheduled has to be cancellable, or a row can come back
        // after the component is gone.
        addEventListener("beforeunload", () => this.timers.forEach(clearTimeout));
      },

      kill(row: DemoRow) {
        if (row.killing) return;

        row.killing = true;
        this.hovered = null;
        this.note = `Killed :${row.port}`;

        // Collapses to nothing, so every row beneath slides up to close the gap.
        // The list itself reserves four rows' height, so the card — and the
        // divider its bottom edge forms — never moves.
        this.timers.push(
          window.setTimeout(() => {
            this.rows = this.rows.filter((r) => r.id !== row.id);
          }, COLLAPSE_MS),
        );

        // Comes back at the bottom of the stack, after an unpredictable pause.
        const downtime = DOWN_MIN_MS + Math.random() * (DOWN_MAX_MS - DOWN_MIN_MS);

        this.timers.push(
          window.setTimeout(() => {
            // Appended collapsed, then expanded on the next frame so it grows
            // into place instead of appearing fully formed.
            this.rows.push({ ...row, killing: true });
            this.note = `:${row.port} restarted`;

            requestAnimationFrame(() => {
              const back = this.rows.find((r) => r.id === row.id);
              if (back) back.killing = false;
            });

            this.timers.push(window.setTimeout(() => (this.note = ""), 2200));
          }, COLLAPSE_MS + downtime),
        );
      },

      open(row: DemoRow) {
        // The demo has no localhost to open, so Open sends people to the source.
        window.open(`https://github.com/${options.repo}`, "_blank", "noopener,noreferrer");
        this.note = `Opened :${row.port}`;
        this.timers.push(window.setTimeout(() => (this.note = ""), 1800));
      },
    }));
  });
</script>
