---
/**
 * Portman's feature grid.
 *
 * Every illustration is markup, not an image: built from the same tokens as the
 * rest of the site so it stays sharp at any density, flips with the theme, and
 * adds nothing to the page weight. Each one shows a real piece of the app rather
 * than decoration.
 */

import FeatureGrid from "@/components/page/FeatureGrid.astro";
import FeatureCard from "@/components/page/FeatureCard.astro";
---

<FeatureGrid
  heading="Built for people running a lot of dev servers at once."
  standfirst="Listing ports is the easy part. These are the bits that aren't."
  columns={2}
>
  <FeatureCard
    index={0}
    title="It knows what your servers are"
    description="Not node (pid 10791). The project, the framework and its version, read from package.json, lockfiles and Vite's dep cache."
  >
    <div class="w-full max-w-[17rem] rounded-xl bg-background-raised p-3.5 shadow-sm ring-1 ring-black/[0.04] dark:ring-white/[0.06]">
      <div class="flex items-baseline gap-2">
        <span class="size-2 shrink-0 translate-y-[-1px] rounded-full bg-emerald-500"></span>
        <span class="text-[15px] font-medium text-foreground">ian.is</span>
        <span class="font-mono text-[13px] text-emerald-600 dark:text-emerald-400">:4321</span>
      </div>
      <div class="mt-1 pl-4 text-[12px] text-foreground-soft">main · Astro 5.2 · 4h 12m</div>
    </div>
  </FeatureCard>

  <FeatureCard
    index={1}
    title="It catches wedged servers"
    description="A server holding its port but no longer answering looks healthy everywhere else. Portman probes each one and says so."
  >
    <div class="flex w-full max-w-[17rem] flex-col gap-2">
      <div class="flex items-center gap-2 rounded-lg bg-background-raised px-3 py-2.5 shadow-sm ring-1 ring-black/[0.04] dark:ring-white/[0.06]">
        <span class="size-2 shrink-0 rounded-full bg-emerald-500"></span>
        <span class="text-[13px] font-medium text-foreground">keep</span>
        <span class="font-mono text-[12px] text-foreground-soft">:5173</span>
      </div>
      <div class="flex items-center gap-2 rounded-lg bg-background-raised px-3 py-2.5 shadow-sm ring-1 ring-amber-500/20">
        <span class="size-2 shrink-0 rounded-full bg-amber-500"></span>
        <span class="text-[13px] font-medium text-foreground">docs</span>
        <span class="font-mono text-[12px] text-foreground-soft">:3001</span>
        <span class="ml-auto rounded bg-amber-500/15 px-1.5 py-0.5 text-[10px] font-medium text-amber-700 dark:text-amber-400">
          not responding
        </span>
      </div>
    </div>
  </FeatureCard>

  <FeatureCard
    index={2}
    title="It groups port conflicts"
    description="When two things fight over 3000 they get their own heading, with both contenders listed so you can see which to keep."
  >
    <div class="w-full max-w-[17rem]">
      <div class="mb-2 flex items-center gap-1.5 px-1">
        <span class="font-mono text-[11px] font-medium tracking-wide text-amber-700 uppercase dark:text-amber-400">
          Conflict on :3000
        </span>
      </div>
      <div class="overflow-hidden rounded-xl bg-background-raised shadow-sm ring-1 ring-black/[0.04] dark:ring-white/[0.06]">
        <div class="flex items-center gap-2 border-b border-border-subtle px-3 py-2.5">
          <span class="size-2 shrink-0 rounded-full bg-emerald-500"></span>
          <span class="text-[13px] text-foreground">seoskill</span>
          <span class="ml-auto text-[11px] text-foreground-soft">Next.js</span>
        </div>
        <div class="flex items-center gap-2 px-3 py-2.5">
          <span class="size-2 shrink-0 rounded-full bg-foreground-soft"></span>
          <span class="text-[13px] text-foreground">old-api</span>
          <span class="ml-auto text-[11px] text-foreground-soft">node</span>
        </div>
      </div>
    </div>
  </FeatureCard>

  <FeatureCard
    index={3}
    title="It shows you the page"
    description="Expand a row for a live thumbnail of localhost, so you can tell which of your six Astro servers is the one you wanted."
  >
    <div class="w-full max-w-[15rem] overflow-hidden rounded-xl bg-background-raised shadow-sm ring-1 ring-black/[0.04] dark:ring-white/[0.06]">
      <div class="flex items-center gap-1.5 border-b border-border-subtle px-3 py-2">
        <span class="size-1.5 rounded-full bg-foreground/15"></span>
        <span class="size-1.5 rounded-full bg-foreground/15"></span>
        <span class="size-1.5 rounded-full bg-foreground/15"></span>
        <span class="ml-1.5 font-mono text-[10px] text-foreground-soft">localhost:4321</span>
      </div>
      <div class="flex flex-col gap-2 p-3.5">
        <div class="h-2 w-2/3 rounded-full bg-foreground/12"></div>
        <div class="h-1.5 w-full rounded-full bg-foreground/[0.07]"></div>
        <div class="h-1.5 w-4/5 rounded-full bg-foreground/[0.07]"></div>
        <div class="mt-1 h-10 w-full rounded-md bg-foreground/[0.05]"></div>
      </div>
    </div>
  </FeatureCard>

  <FeatureCard
    index={4}
    title="It knows about your dead ones"
    description="Servers whose project folder is gone, and the ones agent worktrees left behind, fold away with a single Kill all."
  >
    <div class="flex w-full max-w-[17rem] flex-col gap-2">
      <div class="flex items-center gap-2 rounded-lg bg-background-raised px-3 py-2.5 shadow-sm ring-1 ring-black/[0.04] dark:ring-white/[0.06]">
        <svg class="size-3 shrink-0 text-foreground-soft" viewBox="0 0 16 16" fill="none" aria-hidden="true">
          <path d="M6 4l4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"></path>
        </svg>
        <span class="text-[13px] font-medium text-foreground">Orphans</span>
        <span class="rounded bg-foreground/[0.08] px-1.5 py-0.5 font-mono text-[10px] text-foreground-muted">3</span>
        <span class="ml-auto rounded-md bg-red-500/10 px-2 py-1 text-[11px] font-medium text-red-600 dark:text-red-400">
          Kill all
        </span>
      </div>
      <div class="flex items-center gap-2 rounded-lg bg-background-raised px-3 py-2.5 shadow-sm ring-1 ring-black/[0.04] dark:ring-white/[0.06]">
        <svg class="size-3 shrink-0 text-foreground-soft" viewBox="0 0 16 16" fill="none" aria-hidden="true">
          <path d="M6 4l4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"></path>
        </svg>
        <span class="text-[13px] font-medium text-foreground">Stale worktrees</span>
        <span class="rounded bg-foreground/[0.08] px-1.5 py-0.5 font-mono text-[10px] text-foreground-muted">2</span>
      </div>
    </div>
  </FeatureCard>

  <FeatureCard
    index={5}
    title="It can share a port"
    description="One click opens a Cloudflare tunnel and copies a public URL, with the Host header rewritten so your dev server accepts it."
  >
    <div class="flex w-full max-w-[17rem] flex-col items-center gap-3">
      <div class="flex w-full items-center gap-2 rounded-lg bg-background-raised px-3 py-2.5 shadow-sm ring-1 ring-black/[0.04] dark:ring-white/[0.06]">
        <svg class="size-3.5 shrink-0 text-emerald-600 dark:text-emerald-400" viewBox="0 0 16 16" fill="none" aria-hidden="true">
          <path d="M3 8.5l3.5 3.5L13 5" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"></path>
        </svg>
        <span class="truncate font-mono text-[11px] text-foreground">quiet-hills-9f2.trycloudflare.com</span>
      </div>
      <span class="text-[11px] text-foreground-soft">Copied to your clipboard</span>
    </div>
  </FeatureCard>
</FeatureGrid>
