---
type Props = {
  repo: string;
  downloadUrl: string;
  version: string;
  size: string;
  minimumMacOS: string;
  stars: number | null;
};

import { getButtonClasses } from "@/components/ui/button";

const { repo, downloadUrl, version, size, minimumMacOS, stars } = Astro.props;

const starsLabel =
  stars === null
    ? "Open source"
    : `${stars.toLocaleString("en-US")} ${stars === 1 ? "star" : "stars"} · Open source`;
---

<div class="flex flex-col gap-5">
  <div class="flex flex-wrap items-start gap-3">
    <div class="group flex flex-col gap-2">
      <a
        href={downloadUrl}
        class:list={[getButtonClasses("default", "lg"), "group/download no-underline"]}
      >
        <svg class="size-4" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true">
          <path
            d="M11.18 8.53c.01-1.4 1.17-2.07 1.22-2.1-.66-.97-1.7-1.1-2.06-1.11-.88-.09-1.71.51-2.16.51-.44 0-1.13-.5-1.86-.49-.96.01-1.84.55-2.33 1.4-.99 1.72-.25 4.27.71 5.66.47.68 1.03 1.45 1.77 1.42.71-.03.98-.46 1.84-.46s1.1.46 1.86.44c.77-.01 1.25-.69 1.72-1.38.54-.79.77-1.55.78-1.59-.02-.01-1.5-.58-1.51-2.3ZM9.77 4.4c.39-.47.65-1.13.58-1.79-.56.02-1.24.37-1.64.84-.36.42-.67 1.09-.59 1.73.63.05 1.26-.32 1.65-.78Z"
          ></path>
        </svg>
        Download for macOS
      </a>
      <span class="text-[13px] text-foreground-soft opacity-0 transition-opacity duration-200 group-focus-within:opacity-100 group-hover:opacity-100">
        {version} · {size} · macOS {minimumMacOS}+
      </span>
    </div>

    <div
      class="group flex flex-col gap-2"
      x-data={`githubStars(${JSON.stringify({ repo, initial: stars })})`}
    >
      <div
        class="relative flex flex-col items-start"
        x-data="starEmitter"
        @mouseenter="start()"
        @mouseleave="stop()"
      >
        <a
          href={`https://github.com/${repo}`}
          target="_blank"
          rel="noopener noreferrer"
          class:list={[
            getButtonClasses("outline", "lg"),
            "no-underline transition-transform duration-200 hover:scale-[1.03]",
          ]}
        >
          <svg class="size-4" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true">
            <path
              d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82a7.42 7.42 0 0 1 2-.27c.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8Z"
            ></path>
          </svg>
          Star on GitHub
        </a>

        <span class="pointer-events-none absolute inset-x-0 top-0" aria-hidden="true">
          <template x-for="star in stars" :key="star.id">
            <span class="star" :style="styleFor(star)">★</span>
          </template>
        </span>
      </div>
      <span class="inline-flex items-center gap-1.5 text-[13px] text-foreground-soft opacity-0 transition-opacity duration-200 group-focus-within:opacity-100 group-hover:opacity-100">
        <svg class="size-3.5" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true">
          <path d="m8 1.6 1.9 4.1 4.5.6-3.3 3.1.8 4.4L8 11.7l-3.9 2.1.8-4.4L1.6 6.3l4.5-.6L8 1.6Z"></path>
        </svg>
        <span x-text="label">{starsLabel}</span>
      </span>
    </div>
  </div>

  <a
    href={`https://github.com/${repo}#verify-the-download`}
    target="_blank"
    rel="noopener noreferrer"
    class="inline-flex w-fit items-center gap-1.5 text-[13px] text-foreground-muted underline decoration-border-strong underline-offset-2 transition-colors hover:text-foreground"
  >
    <svg class="size-3.5" viewBox="0 0 16 16" fill="none" aria-hidden="true">
      <path d="M8 1.5 3 3.5v4c0 3 2.1 5.6 5 6.5 2.9-.9 5-3.5 5-6.5v-4L8 1.5Z" stroke="currentColor" stroke-width="1.3" stroke-linejoin="round"></path>
      <path d="m6 7.8 1.5 1.5L10.5 6" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round"></path>
    </svg>
    Verify the download
  </a>
</div>

<style>
  .star {
    position: absolute;
    left: 50%;
    top: 0;
    line-height: 1;
    color: color-mix(in oklab, currentColor 32%, transparent);
    opacity: 0;
    animation: star-rise var(--star-duration, 900ms) ease-out forwards;
  }

  @keyframes star-rise {
    0% {
      opacity: 0;
      translate: 0 0;
      scale: 0.35;
    }
    30% {
      opacity: 0.55;
    }
    100% {
      opacity: 0;
      translate: var(--star-drift, 0) calc(var(--star-rise, 28px) * -1);
      scale: 1;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .star {
      display: none;
    }
  }
</style>
