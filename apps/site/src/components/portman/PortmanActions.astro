---
import ProjectActions from "@/components/projects/ProjectActions.astro";

type Props = {
  repo: string;
  downloadUrl: string;
  version: string;
  size: string;
  minimumMacOS: string;
  stars: number | null;
};

const { repo, downloadUrl, version, size, minimumMacOS, stars } = Astro.props;
---

<ProjectActions
  repo={repo}
  stars={stars}
  primaryLabel="Download for macOS"
  primaryHref={downloadUrl}
  primaryKind="download"
  primaryDetail={`${version} · ${size} · macOS ${minimumMacOS}+`}
  verifyHref={`https://github.com/${repo}#verify-the-download`}
/>
