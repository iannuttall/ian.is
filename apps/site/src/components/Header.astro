---
/**
 * One-line site header: the name as the home link on the left, a short
 * text nav on the right. No menu overlay; everything fits on one row at
 * every width. Breadcrumb JSON-LD still comes from the layout.
 */
import Logo from "@/components/Logo.astro";

const navItems = [
  { label: "About", href: "/about" },
  { label: "Posts", href: "/posts" },
  { label: "Tools", href: "/tools" },
];

const pathname = Astro.url.pathname.replace(/\/$/, "") || "/";

function isActive(href: string) {
  return pathname === href || pathname.startsWith(`${href}/`);
}
---

<header class="site-frame flex items-center justify-between gap-6 py-6">
  <a
    href="/"
    class="text-foreground no-underline transition-opacity hover:opacity-70"
    aria-label="Ian Nuttall home"
    aria-current={pathname === "/" ? "page" : undefined}
  >
    <Logo class="h-5" />
  </a>
  <nav aria-label="Site">
    <ul class="flex items-center gap-5 text-sm">
      {navItems.map((item) => (
        <li>
          <a
            href={item.href}
            class:list={[
              "no-underline underline-offset-2 transition-colors hover:text-foreground",
              isActive(item.href) ? "text-foreground" : "text-foreground-muted",
            ]}
            aria-current={isActive(item.href) ? "page" : undefined}
          >
            {item.label}
          </a>
        </li>
      ))}
    </ul>
  </nav>
</header>
