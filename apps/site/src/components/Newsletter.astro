---
/**
 * Newsletter signup, kept deliberately plain: a heading, one line of copy,
 * an input beside a button, and a link to the archive. No card, no
 * decoration, so it reads as part of the page rather than a widget.
 *
 * All colours come from the palette tokens so a theme can restyle it.
 */
interface Props {
  /** Kept for callers; the block no longer renders as a card. */
  standalone?: boolean;
  heading?: string;
  description?: string;
  /** Where the signup came from, forwarded to the list backend. */
  source?: string;
  /** Kept for callers; spacing is now the same everywhere. */
  compact?: boolean;
}

const {
  heading = "Ian's List",
  description = "What I learned this month actually using AI to run my business.",
  source = "ian.is",
} = Astro.props;
---

<section
  data-newsletter
  class="flex w-full flex-col gap-2"
  x-data={`newsletterSignup(${JSON.stringify({ source, heading, description })})`}
>
  <h2 class="text-base font-medium text-foreground" x-text="status === 'success' ? successHeading : initialHeading">{heading}</h2>
  <p class="text-pretty text-foreground-muted" x-text="status === 'success' ? successDescription : initialDescription">
    {description}
  </p>

  <div class="mt-3 grid">
    <p
      hidden
      x-bind:hidden="status !== 'success'"
      class="col-start-1 row-start-1 flex min-h-10 items-center gap-2 self-center text-sm font-medium text-success"
    >
      <svg
        class="size-4"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2.5"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
      >
        <path d="M20 6 9 17l-5-5"></path>
      </svg>
      <span x-text="message"></span>
    </p>

    <form class="col-start-1 row-start-1 flex w-full flex-col gap-2 sm:flex-row" x-on:submit.prevent="submit" x-bind:hidden="status === 'success'">
      <label for="newsletter-email" class="sr-only">Email address</label>
      <input
        id="newsletter-email"
        type="email"
        required
        x-model="email"
        x-bind:aria-invalid="status === 'error' ? 'true' : 'false'"
        aria-describedby="newsletter-status"
        placeholder="Enter your email address"
        autocomplete="email"
        class="h-10 w-full min-w-0 rounded-md sm:flex-1 border-0 bg-muted px-3.5 text-sm text-foreground outline-none transition-[box-shadow] placeholder:text-foreground-soft focus-visible:ring-2 focus-visible:ring-ring/40 aria-invalid:ring-2 aria-invalid:ring-destructive/40"
      />
      <button
        type="submit"
        disabled
        x-bind:disabled="status === 'loading' || !ready"
        class="inline-flex h-10 shrink-0 items-center justify-center gap-2 rounded-md bg-foreground px-4 text-sm font-medium text-background transition-opacity hover:opacity-85 disabled:opacity-60"
      >
        <span hidden x-bind:hidden="status !== 'loading'" class="inline-flex">
          <svg class="size-4 animate-spin" viewBox="0 0 24 24" fill="none" aria-hidden="true">
            <circle cx="12" cy="12" r="9" stroke="currentColor" stroke-opacity="0.25" stroke-width="3"></circle>
            <path d="M21 12a9 9 0 0 0-9-9" stroke="currentColor" stroke-width="3" stroke-linecap="round"></path>
          </svg>
        </span>
        Subscribe
      </button>
      <p id="newsletter-status" class="sr-only" aria-live="polite" x-text="message"></p>
    </form>
  </div>

  <p class="mt-2 flex flex-wrap items-baseline gap-x-2 text-sm">
    <a href="/issues" class="font-medium text-foreground no-underline underline-offset-2 hover:underline hover:decoration-dotted">
      Read previous issues &rarr;
    </a>
    <span
      x-data="subscriberCount"
      x-bind:style="visible ? 'opacity: 1' : 'opacity: 0'"
      x-bind:aria-hidden="visible ? 'false' : 'true'"
      class="text-foreground-soft transition-opacity duration-200"
      style="opacity: 0"
    >
      <span x-text="displayCount">0</span>+ subscribers
    </span>
  </p>
</section>
