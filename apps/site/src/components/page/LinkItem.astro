---
type Props = {
  title: string;
  href?: string;
  meta?: string;
  external?: boolean;
};

import ExternalLink from "@/components/icons/ExternalLink.astro";
import { externalLinkAttrs, isExternalHref } from "@/lib/external-links.mjs";

const { title, href, meta, external } = Astro.props;
const hasHref = typeof href === "string" && href.length > 0;
const linkAttrs = hasHref ? externalLinkAttrs(href) : {};
const isExternal = hasHref && (external ?? isExternalHref(href));
const Element = hasHref ? "a" : "div";
const hasDescription = Astro.slots.has("default");
---

<li class="flex">
  <Element
    {...linkAttrs}
    {...(hasHref ? { "data-hover-item": true } : {})}
    class:list={[
      "flex flex-1 items-baseline gap-2 rounded-md px-2 py-1.5 no-underline outline-none",
      hasHref ? "focus-visible:bg-foreground/[0.05]" : null,
    ]}
  >
    <span class="font-medium text-foreground">
      {title}
    </span>
    {isExternal ? (
      <ExternalLink
        class="size-4 shrink-0 translate-y-0.5 text-foreground-soft"
        aria-hidden="true"
      />
    ) : null}
    {hasDescription ? (
      <span class="hidden min-w-0 items-baseline gap-2 text-foreground-muted sm:flex [&>p]:m-0">
        <span aria-hidden="true" class="text-foreground-soft">&mdash;</span>
        <slot />
      </span>
    ) : null}
    {meta ? (
      <span class="ml-auto hidden shrink-0 text-foreground-soft sm:inline">
        {meta}
      </span>
    ) : null}
  </Element>
</li>
