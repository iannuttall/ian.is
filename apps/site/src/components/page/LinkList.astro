---
/**
 * A list of LinkItems sharing one sliding hover highlight. Items carry a
 * small negative margin so the highlight pill sits wider than the text.
 */
import HoverHighlight from "@/components/page/HoverHighlight.astro";
---

<ul class="relative isolate -mx-2 flex flex-col" x-data="hoverGroup">
  <HoverHighlight />
  <slot />
</ul>
