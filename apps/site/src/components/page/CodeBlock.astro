---
import { cn } from "@/lib/utils";

type Props = {
  code: string;
  label?: string;
  expression?: string;
  class?: string;
};

const { code, label = "Copy code", expression, class: className } = Astro.props;
---

<div class={cn("code-frame", className)}>
  <pre
    class="overflow-x-auto rounded-lg border border-border bg-muted py-3 pr-12 pl-4 font-mono text-[13px]/6 text-foreground"><code x-text={expression}>{code}</code></pre>
  <button type="button" class="code-copy" data-code-copy aria-label={label}></button>
</div>
