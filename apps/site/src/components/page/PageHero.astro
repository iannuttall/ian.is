---
type Props = {
  title: string;
};

import PageRail from "@/components/page/PageRail.astro";

const { title } = Astro.props;
---

<section class="flex flex-col bg-background pt-4 text-foreground">
  <PageRail
    class="group/page-hero"
    leftClass="bottom-16 sm:bottom-24"
    rightClass="top-[calc(50%+2rem)] -translate-y-1/2"
  >
    <Fragment slot="left">
      <slot name="left" />
    </Fragment>
    <div class="flex flex-col gap-8 pt-12 pb-10 sm:pt-16 sm:pb-12">
      <div class="flex max-w-2xl flex-col gap-4">
        <h1 class="text-pretty text-xl font-medium">
          {title}
        </h1>
        <div class="text-pretty text-base text-foreground-muted [&>p+p]:mt-4 [&>p]:m-0">
          <slot />
        </div>
      </div>
    </div>
    <Fragment slot="right">
      <slot name="right" />
    </Fragment>
  </PageRail>
</section>
