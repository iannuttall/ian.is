---
import { ChevronDownIcon } from "@/components/ui/icon";

type FaqItem = {
  question: string;
  answer: string;
};

type Props = {
  heading?: string;
  items: FaqItem[];
  idPrefix?: string;
};

const { heading = "Common questions", items, idPrefix = "faq" } = Astro.props;

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: items.map((item) => ({
    "@type": "Question",
    name: item.question,
    acceptedAnswer: {
      "@type": "Answer",
      text: item.answer.replace(/<[^>]+>/g, ""),
    },
  })),
};
---

<section class="site-frame py-16 sm:py-24">
  <h2 class="max-w-2xl text-pretty text-lg font-medium">
    {heading}
  </h2>

  <div class="mt-8 max-w-3xl border-t border-border sm:mt-10">
    {
      items.map((item, index) => (
        <details id={`${idPrefix}-${index + 1}`} class="group border-b border-border">
          <summary class="flex cursor-pointer list-none items-center justify-between gap-4 rounded-md border border-transparent py-4 text-left text-[15px] font-medium text-foreground outline-none transition-all focus-visible:border-ring focus-visible:ring-ring/20 focus-visible:ring-[3px] [&::-webkit-details-marker]:hidden">
            <h3>{item.question}</h3>
            <ChevronDownIcon class="size-3.5 shrink-0 text-foreground transition-transform duration-200 group-open:rotate-180" />
          </summary>
          <div class="pb-4">
            <div
              class="max-w-2xl text-[15px]/relaxed text-foreground-muted [&_a]:underline [&_a]:decoration-border-strong [&_a]:underline-offset-2 [&_code]:rounded [&_code]:bg-foreground/[0.06] [&_code]:px-1.5 [&_code]:py-0.5 [&_code]:font-mono [&_code]:text-[13px]"
              set:html={item.answer}
            />
          </div>
        </details>
      ))
    }
  </div>
</section>

<script type="application/ld+json" set:html={JSON.stringify(faqSchema)} is:inline />
