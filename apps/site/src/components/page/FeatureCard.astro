---
import { cn } from "@/lib/utils";

type Props = {
  title: string;
  description: string;
  index?: number;
  class?: string;
};

const { title, description, index = 0, class: className } = Astro.props;

const delay = Math.min(index, 5) * 70;
---

<div
  class={cn(
    "feature-card group flex flex-col overflow-hidden rounded-2xl bg-foreground/[0.04]",
    className,
  )}
  style={`--feature-delay:${delay}ms`}
>
  <div
    class="relative flex h-[13rem] shrink-0 items-center justify-center overflow-hidden px-6"
    aria-hidden="true"
  >
    <slot />
  </div>

  <div class="flex flex-col gap-1 p-5 pt-0">
    <h3 class="text-lg font-medium -tracking-[0.2px] text-foreground">{title}</h3>
    <p class="text-pretty text-[15px]/relaxed text-foreground-muted">{description}</p>
  </div>
</div>

<style>
  /* Blur on the way in, so the card resolves rather than just sliding. Runs
     once on load; there's no scroll observer to keep alive. */
  .feature-card {
    animation: feature-card-in 600ms cubic-bezier(0.16, 1, 0.3, 1) both;
    animation-delay: var(--feature-delay, 0ms);
  }

  @keyframes feature-card-in {
    from {
      opacity: 0;
      filter: blur(6px);
      transform: translateY(12px);
    }
    to {
      opacity: 1;
      filter: blur(0);
      transform: translateY(0);
    }
  }

  /* No entrance at all for anyone who's asked for less movement — and no
     lingering opacity:0, which is how these things end up invisible. */
  @media (prefers-reduced-motion: reduce) {
    .feature-card {
      animation: none;
    }
  }
</style>
