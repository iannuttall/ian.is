---
type Props = {
  href: string;
  external?: boolean;
  class?: string;
  iconClass?: string;
  [key: string]: unknown;
};

import ExternalLink from "@/components/icons/ExternalLink.astro";
import { externalLinkAttrs, isExternalHref } from "@/lib/external-links.mjs";

const {
  href,
  external,
  class: className,
  iconClass,
  ...props
} = Astro.props as Props;
const isExternal = external ?? isExternalHref(href);
const linkAttrs = isExternal ? externalLinkAttrs(href) : { href };
---

<a
  {...linkAttrs}
  {...props}
  class:list={[
    "group/link inline-flex items-baseline gap-1 no-underline align-baseline font-medium text-foreground transition-colors hover:text-foreground-muted",
    className,
  ]}
>
  <span>
    <slot />
  </span>
  {
    isExternal ? (
      <ExternalLink
        class:list={[
          "size-5 shrink-0 translate-y-0.5 text-current",
          iconClass,
        ]}
        aria-hidden="true"
      />
    ) : null
  }
</a>
