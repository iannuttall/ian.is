---
import PageSection from "@/components/page/PageSection.astro";
import LinkList from "@/components/page/LinkList.astro";
import LinkItem from "@/components/page/LinkItem.astro";

const projects = [
  {
    title: "Keep",
    href: "/keep",
    description: "Save anything as Markdown",
  },
  {
    title: "SEO Skill",
    href: "/seo-skill",
    description: "The only SEO skill your agent needs",
  },
  {
    title: "Swipe",
    href: "/swipe",
    description: "The best AI skills and tools for work",
  },
  {
    title: "Caffeine",
    href: "/caffeine",
    description: "Keep your Mac awake while agents work",
  },
  {
    title: "Natter",
    href: "/natter",
    description: "Local dictation for technical work",
  },
  {
    title: "Portman",
    href: "/portman",
    description: "Find and kill zombie dev servers",
  },
  {
    title: "Unclaimed",
    href: "/unclaimed",
    description: "Find available single-word domains",
  },
  {
    title: "Mailroom",
    href: "/mailroom",
    description: "Email inboxes for agents",
  },
  {
    title: "Clockwork",
    href: "/clockwork",
    description: "Schedule commands on your Mac",
  },
  {
    title: "ilo",
    href: "/ilo",
    description: "Performance analytics for 𝕏",
  },
];
---

<PageSection title="Projects">
  <LinkList>
    {projects.map((project) => (
      <LinkItem title={project.title} href={project.href}>
        {project.description}
      </LinkItem>
    ))}
  </LinkList>
</PageSection>
