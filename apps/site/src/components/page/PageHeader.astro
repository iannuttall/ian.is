---
// Shared page header matching the homepage hero typography, so archive and
// detail pages stay on the same type scale as the home h1/subtitle.

interface Props {
  title: string;
  subtitle?: string;
}

const { title, subtitle } = Astro.props;
---

<header class="flex max-w-2xl flex-col gap-4">
  <h1 class="text-pretty text-xl font-medium text-foreground">
    {title}
  </h1>
  {subtitle ? (
    <p class="text-pretty text-base text-foreground-muted">
      {subtitle}
    </p>
  ) : null}
  <slot />
</header>
